# ===========================================
# TRANSPROCHE Frontend - Production Configuration
# ===========================================
# These values are used at BUILD TIME for Next.js
# They will be embedded in the JavaScript bundle

# API Configuration
NEXT_PUBLIC_API_URL=https://api.transproche.com/api
# Or if using same domain: NEXT_PUBLIC_API_URL=https://transproche.com/api

# Application Name
NEXT_PUBLIC_APP_NAME=TRANSPROCHE

# ===========================================
# Optional: Analytics & Monitoring
# ===========================================
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
